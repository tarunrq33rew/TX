# ============================================
# TG10X Ecosystem Portal — Environment Config
# ============================================
# Copy this file to .env and fill in your real keys:
#   cp .env.example .env

# --- Google Gemini AI (used for AI-powered search) ---
GEMINI_API_KEY="your_gemini_api_key_here"

# --- App Base URL ---
APP_URL="http://localhost:3000"

# --- Supabase (Server-side) ---
# Used by the Express backend for database sync & auth
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# --- Supabase (Client-side / Browser) ---
# NEXT_PUBLIC_ prefix exposes these to the frontend React app
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"
